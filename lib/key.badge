// Front-panel key helpers.  The measured KeyReg values are documented in
// docs/keys.md; these wrappers keep call sites readable.

fn nibble key_op8() {
    return 1;
}

fn nibble key_op4() {
    return 2;
}

fn nibble key_op2() {
    return 3;
}

fn nibble key_op1() {
    return 4;
}

fn nibble key_dep() {
    return 0;
}

// Wait for the next key press and return its code.
fn nibble key_wait() {
    while (!key_just()) {
    }
    return key_code();
}

// Wait for a press, then wait for that key to be released.
fn nibble key_wait_release() {
    nibble code;
    while (!key_just()) {
    }
    code = key_code();
    while (key_last()) {
    }
    return code;
}

fn nibble key_wait_any() {
    while (!key_any()) {
    }
    return key_code();
}

fn flashptr key_name(nibble code) {
    if (code == key_op8()) {
        return "OPCODE 8";
    }
    if (code == key_op4()) {
        return "OPCODE 4";
    }
    if (code == key_op2()) {
        return "OPCODE 2";
    }
    if (code == key_op1()) {
        return "OPCODE 1";
    }
    if (code == key_dep()) {
        return "DEP+/CLOCK/STEP";
    }
    return "UNKNOWN";
}
