import "lib/key.nbl";
import "lib/uart.nbl";
// Press each front-panel button once.  This prints the KeyReg code and
// KeyStatus over UART so Niblick can map physical buttons reliably.

fn main() {
    uart_route(1);
    uart_init(3);
    uart_puts("KEYMAP READY\n");

    while (1) {
        if (key_just()) {
            uart_puts("KEY=");
            uart_print_nibble(key_code());
            uart_puts(" STATUS=");
            uart_print_nibble(key_status());
            uart_putc('\n');
        }
    }
}
