// UART formatting helpers built on uart_putc / uart_getc.
// These add no RAM of their own; unused functions are removed by the
// compiler's dead-declaration pass.

fn void uart_nl() {
    uart_putc(10);
}

fn void uart_print_nibble(nibble v) {
    if (v < 10) {
        uart_putc('0' + v);
    } else {
        uart_putc('A' + v - 10);
    }
}

fn void uart_print_hex8(char v) {
    uart_print_nibble(high_nibble(v));
    uart_print_nibble(low_nibble(v));
}

fn void uart_print_bin8(char v) {
    char mask;
    mask = 128;
    while (mask != 0) {
        if ((v & mask) != 0) {
            uart_putc('1');
        } else {
            uart_putc('0');
        }
        mask = mask >> 1;
    }
}

fn void uart_print_dec8(char v) {
    nibble hundreds;
    nibble tens;
    nibble ones;

    hundreds = 0;
    while (v >= 100) {
        v = v - 100;
        hundreds = hundreds + 1;
    }
    tens = 0;
    while (v >= 10) {
        v = v - 10;
        tens = tens + 1;
    }
    ones = low_nibble(v);

    if (hundreds != 0) {
        uart_putc('0' + hundreds);
    }
    if (hundreds != 0 || tens != 0) {
        uart_putc('0' + tens);
    }
    uart_putc('0' + ones);
}

fn void uart_print_hex16(word v) {
    uart_print_hex8((char)(v >> 8));
    uart_print_hex8((char)v);
}

fn void uart_print_dec16(word v) {
    nibble digit;
    nibble started;
    started = 0;

    digit = (nibble)(v / 10000);
    v = v % 10000;
    if (digit != 0) {
        uart_putc('0' + digit);
        started = 1;
    }
    digit = (nibble)(v / 1000);
    v = v % 1000;
    if (started != 0 || digit != 0) {
        uart_putc('0' + digit);
        started = 1;
    }
    digit = (nibble)(v / 100);
    v = v % 100;
    if (started != 0 || digit != 0) {
        uart_putc('0' + digit);
        started = 1;
    }
    digit = (nibble)(v / 10);
    v = v % 10;
    if (started != 0 || digit != 0) {
        uart_putc('0' + digit);
    }
    uart_putc('0' + (nibble)v);
}

// Signed decimal formatting for raw two's-complement values.
fn void uart_print_dec8_signed(char v) {
    if ((v & 128) != 0) {
        uart_putc('-');
        v = 0 - v;
    }
    uart_print_dec8(v);
}

fn void uart_print_dec16_signed(word v) {
    if ((v & 0x8000) != 0) {
        uart_putc('-');
        v = 0 - v;
    }
    uart_print_dec16(v);
}

fn void uart_print_hex32(dword v) {
    uart_print_hex16((word)(v >> 16));
    uart_print_hex16((word)v);
}

fn void uart_print_dec32(dword v) {
    dword divisor;
    nibble digit;
    nibble started;

    divisor = 1000000000;
    started = 0;
    while (divisor != 0) {
        digit = (nibble)(v / divisor);
        v = v % divisor;
        if (started != 0 || digit != 0 || divisor == 1) {
            uart_putc('0' + digit);
            started = 1;
        }
        divisor = divisor / 10;
    }
}

fn void uart_print_str(char addr) {
    char c;
    c = peek8(addr);
    while (c != 255) {
        uart_putc(c);
        addr = addr + 2;
        c = peek8(addr);
    }
}

fn void uart_print_hexdump(char addr, nibble len) {
    while (len != 0) {
        uart_print_hex8(peek8(addr));
        uart_putc(' ');
        addr = addr + 2;
        len = len - 1;
    }
    uart_nl();
}

fn char uart_hex_value(char c) {
    if (c >= '0') {
        if (c <= '9') {
            return low_nibble(c - '0');
        }
    }
    if (c >= 'A') {
        if (c <= 'F') {
            return low_nibble(c - 'A') + 10;
        }
    }
    if (c >= 'a') {
        if (c <= 'f') {
            return low_nibble(c - 'a') + 10;
        }
    }
    return 0;
}

fn char uart_read_hex8() {
    char high;
    char low;
    high = uart_hex_value(uart_getc());
    low = uart_hex_value(uart_getc());
    return (high << 4) + low;
}

fn nibble uart_read_nibble() {
    return uart_hex_value(uart_getc());
}

// Read bytes until CR or LF.  Returns the number of bytes stored.  The
// buffer is terminated with 0xFF and is not echoed.
fn nibble uart_read_line(char addr, nibble max) {
    nibble count;
    char c;
    count = 0;
    c = uart_getc();
    while (c != 10 && c != 13) {
        if (count < max) {
            poke8(addr, c);
            addr = addr + 2;
            count = count + 1;
        }
        c = uart_getc();
    }
    poke8(addr, 255);
    return count;
}
