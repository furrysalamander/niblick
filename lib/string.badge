// Byte strings in RAM addressed by an 8-bit char address.
// The terminator is 0xFF, matching flash strings and uart_puts.

fn char str_len(char addr) {
    char count;
    count = 0;
    while (peek8(addr) != 255) {
        addr = addr + 2;
        count = count + 1;
    }
    return count;
}

// 1 when the strings are identical, including the terminator.
fn nibble str_eq(char a, char b) {
    while (peek8(a) == peek8(b)) {
        if (peek8(a) == 255) {
            return 1;
        }
        a = a + 2;
        b = b + 2;
    }
    return 0;
}

fn void str_copy(char dst, char src) {
    char c;
    c = peek8(src);
    while (c != 255) {
        poke8(dst, c);
        dst = dst + 2;
        src = src + 2;
        c = peek8(src);
    }
    poke8(dst, 255);
}

fn void str_cat(char dst, char src) {
    while (peek8(dst) != 255) {
        dst = dst + 2;
    }
    str_copy(dst, src);
}

// Address of the first match, or 0 when absent.  RAM variables start at
// 0x40, so 0 is safe as "not found".
fn char str_chr(char addr, char ch) {
    char c;
    c = peek8(addr);
    while (c != 255) {
        if (c == ch) {
            return addr;
        }
        addr = addr + 2;
        c = peek8(addr);
    }
    return 0;
}

fn char str_len_flash(flashptr p) {
    char count;
    count = 0;
    while (flash_next(&p) != 255) {
        count = count + 1;
    }
    return count;
}

fn void str_copy_flash(char dst, flashptr src) {
    char c;
    c = flash_next(&src);
    while (c != 255) {
        poke8(dst, c);
        dst = dst + 2;
        c = flash_next(&src);
    }
    poke8(dst, 255);
}

// ---------------------------------------------------------------------------
// Number conversion
// ---------------------------------------------------------------------------

fn nibble str_from_dec8(char addr, char value) {
    nibble hundreds;
    nibble tens;
    nibble len;
    hundreds = 0;
    while (value >= 100) {
        value = value - 100;
        hundreds = hundreds + 1;
    }
    tens = 0;
    while (value >= 10) {
        value = value - 10;
        tens = tens + 1;
    }
    len = 0;
    if (hundreds != 0) {
        poke8(addr, '0' + hundreds);
        addr = addr + 2;
        len = len + 1;
    }
    if (hundreds != 0 || tens != 0) {
        poke8(addr, '0' + tens);
        addr = addr + 2;
        len = len + 1;
    }
    poke8(addr, '0' + low_nibble(value));
    addr = addr + 2;
    len = len + 1;
    poke8(addr, 255);
    return len;
}

fn char str_to_dec8(char addr) {
    char value;
    char c;
    value = 0;
    c = peek8(addr);
    while (c >= '0' && c <= '9') {
        value = (char)(value * 10 + (c - '0'));
        addr = addr + 2;
        c = peek8(addr);
    }
    return value;
}

fn nibble str_from_hex8(char addr, char value) {
    nibble hi;
    nibble lo;
    hi = high_nibble(value);
    lo = low_nibble(value);
    if (hi < 10) {
        poke8(addr, '0' + hi);
    } else {
        poke8(addr, 'A' + hi - 10);
    }
    if (lo < 10) {
        poke8(addr + 2, '0' + lo);
    } else {
        poke8(addr + 2, 'A' + lo - 10);
    }
    poke8(addr + 4, 255);
    return 2;
}

fn char str_hex_digit(char c) {
    if (c >= '0' && c <= '9') {
        return c - '0';
    }
    if (c >= 'A' && c <= 'F') {
        return c - 'A' + 10;
    }
    if (c >= 'a' && c <= 'f') {
        return c - 'a' + 10;
    }
    return 0;
}

fn char str_to_hex8(char addr) {
    char hi;
    char lo;
    hi = str_hex_digit(peek8(addr));
    lo = str_hex_digit(peek8(addr + 2));
    return (hi << 4) | lo;
}

// ---------------------------------------------------------------------------
// Searching, comparison, case, reverse
// ---------------------------------------------------------------------------

fn nibble str_match_at(char addr, flashptr needle) {
    char c;
    char n;
    while (1) {
        n = flash_next(&needle);
        if (n == 255) {
            return 1;
        }
        c = peek8(addr);
        if (c != n) {
            return 0;
        }
        addr = addr + 2;
    }
}

fn char str_find(char addr, flashptr needle) {
    char c;
    c = peek8(addr);
    while (c != 255) {
        if (str_match_at(addr, needle) != 0) {
            return addr;
        }
        addr = addr + 2;
        c = peek8(addr);
    }
    return 0;
}

fn nibble str_contains(char addr, flashptr needle) {
    if (str_find(addr, needle) != 0) {
        return 1;
    }
    return 0;
}

fn nibble str_starts_with(char addr, flashptr prefix) {
    return str_match_at(addr, prefix);
}

fn nibble str_eq_flash(char addr, flashptr s) {
    char c;
    char f;
    while (1) {
        c = peek8(addr);
        f = flash_next(&s);
        if (c != f) {
            return 0;
        }
        if (c == 255) {
            return 1;
        }
        addr = addr + 2;
    }
}

fn void str_cat_flash(char dst, flashptr src) {
    char c;
    while (peek8(dst) != 255) {
        dst = dst + 2;
    }
    c = flash_next(&src);
    while (c != 255) {
        poke8(dst, c);
        dst = dst + 2;
        c = flash_next(&src);
    }
    poke8(dst, 255);
}

const nibble STR_LT = 15;
const nibble STR_EQ = 0;
const nibble STR_GT = 1;

fn nibble str_compare(char a, char b) {
    char ca;
    char cb;
    while (1) {
        ca = peek8(a);
        cb = peek8(b);
        if (ca != cb) {
            if (ca < cb) {
                return STR_LT;
            }
            return STR_GT;
        }
        if (ca == 255) {
            return STR_EQ;
        }
        a = a + 2;
        b = b + 2;
    }
}

fn void str_upper(char addr) {
    char c;
    c = peek8(addr);
    while (c != 255) {
        if (c >= 'a' && c <= 'z') {
            poke8(addr, c - 32);
        }
        addr = addr + 2;
        c = peek8(addr);
    }
}

fn void str_lower(char addr) {
    char c;
    c = peek8(addr);
    while (c != 255) {
        if (c >= 'A' && c <= 'Z') {
            poke8(addr, c + 32);
        }
        addr = addr + 2;
        c = peek8(addr);
    }
}

fn void str_reverse(char addr) {
    char lo;
    char hi;
    char tmp;
    lo = addr;
    hi = addr;
    while (peek8(hi) != 255) {
        hi = hi + 2;
    }
    if (hi == lo) {
        return;
    }
    hi = hi - 2;
    while (lo < hi) {
        tmp = peek8(lo);
        poke8(lo, peek8(hi));
        poke8(hi, tmp);
        lo = lo + 2;
        hi = hi - 2;
    }
}

// Trim leading/trailing spaces in place; returns the new string start.
fn char str_trim(char addr) {
    char start;
    char end;
    char c;
    start = addr;
    while (peek8(start) == ' ') {
        start = start + 2;
    }
    end = start;
    while (peek8(end) != 255) {
        end = end + 2;
    }
    while (end > start && peek8(end - 2) == ' ') {
        end = end - 2;
    }
    poke8(end, 255);
    return start;
}

// ---------------------------------------------------------------------------
// 16- and 32-bit conversion
//
// Buffer sizes: dec16 needs 6 bytes (5 digits + terminator), dec32 needs 11
// bytes (10 digits + terminator), hex16 needs 5 bytes, hex32 needs 9 bytes.
// ---------------------------------------------------------------------------

fn nibble str_from_dec16(char addr, word value) {
    nibble digit;
    nibble started;
    nibble len;
    started = 0;
    len = 0;
    digit = (nibble)(value / 10000);
    value = value % 10000;
    if (digit != 0) {
        poke8(addr, '0' + digit);
        addr = addr + 2;
        len = len + 1;
        started = 1;
    }
    digit = (nibble)(value / 1000);
    value = value % 1000;
    if (started != 0 || digit != 0) {
        poke8(addr, '0' + digit);
        addr = addr + 2;
        len = len + 1;
        started = 1;
    }
    digit = (nibble)(value / 100);
    value = value % 100;
    if (started != 0 || digit != 0) {
        poke8(addr, '0' + digit);
        addr = addr + 2;
        len = len + 1;
        started = 1;
    }
    digit = (nibble)(value / 10);
    value = value % 10;
    if (started != 0 || digit != 0) {
        poke8(addr, '0' + digit);
        addr = addr + 2;
        len = len + 1;
    }
    poke8(addr, '0' + (nibble)value);
    addr = addr + 2;
    len = len + 1;
    poke8(addr, 255);
    return len;
}

fn word str_to_dec16(char addr) {
    word value;
    char c;
    value = 0;
    c = peek8(addr);
    while (c >= '0' && c <= '9') {
        value = value * 10 + (word)(c - '0');
        addr = addr + 2;
        c = peek8(addr);
    }
    return value;
}

fn nibble str_from_dec32(char addr, dword value) {
    dword divisor;
    nibble digit;
    nibble started;
    nibble len;
    divisor = 1000000000;
    started = 0;
    len = 0;
    while (divisor != 0) {
        digit = (nibble)(value / divisor);
        value = value % divisor;
        if (started != 0 || digit != 0 || divisor == 1) {
            poke8(addr, '0' + digit);
            addr = addr + 2;
            len = len + 1;
            started = 1;
        }
        divisor = divisor / 10;
    }
    poke8(addr, 255);
    return len;
}

fn dword str_to_dec32(char addr) {
    dword value;
    char c;
    value = 0;
    c = peek8(addr);
    while (c >= '0' && c <= '9') {
        value = value * 10 + (dword)(c - '0');
        addr = addr + 2;
        c = peek8(addr);
    }
    return value;
}

fn nibble str_from_hex16(char addr, word value) {
    str_from_hex8(addr, (char)(value >> 8));
    str_from_hex8(addr + 4, (char)value);
    return 4;
}

fn word str_to_hex16(char addr) {
    word high;
    word low;
    high = (word)str_to_hex8(addr);
    low = (word)str_to_hex8(addr + 4);
    return (high << 8) | low;
}

fn nibble str_from_hex32(char addr, dword value) {
    str_from_hex16(addr, (word)(value >> 16));
    str_from_hex16(addr + 8, (word)value);
    return 8;
}

fn dword str_to_hex32(char addr) {
    dword high;
    dword low;
    high = (dword)str_to_hex16(addr);
    low = (dword)str_to_hex16(addr + 8);
    return (high << 16) | low;
}
