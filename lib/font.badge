// Return one 8-bit column (top-to-bottom) for a character.
fn char font5x8_column(char c, nibble col) {
    char glyph;
    char index;
    if (c < 32) {
        c = 32;
    }
    if (c > 127) {
        c = 63;
    }
    glyph = c - 32;
    if (glyph < 48) {
        index = (char)(glyph * 5 + col);
        return font5x8_lo[index];
    }
    index = (char)((glyph - 48) * 5 + col);
    return font5x8_hi[index];
}

fn nibble font5x8_width(char c) {
    return 5;
}

// Draw one glyph at (x, y) in a 32-nibble framebuffer.  The glyph is five
// columns wide and eight rows tall; drawing is clipped to the 8x16 display.
fn void text_draw_char(char base, nibble x, char y, char c) {
    nibble col;
    nibble row;
    char bits;
    col = 0;
    while (col < 5) {
        if ((x + col) < 8) {
            bits = font5x8_column(c, col);
            row = 0;
            while (row < 8) {
                if ((y + row) < 16) {
                    pixel_set(base, x + col, y + row, (bits & (128 >> row)) != 0);
                }
                row = row + 1;
            }
        }
        col = col + 1;
    }
}
