// First-order PDM sample playback.
//
// The encoder is the same error-feedback loop used by the upstream
// tmiw-pdm-synth demo.  It drives OUT bits 1-3 (bit 0 stays 1).  Connect one
// of those pins to a low-pass filter and an amplifier.  Clock is set to its
// maximum (250 kHz); the actual sample rate depends on the loop timing.

import "lib/time.nbl";

nibble pdm_error;

fn void pdm_init() {
    time_clock_set(CLOCK_250K);
    pdm_error = 0;
}

fn void pdm_silence() {
    out(1);
}

// Encode one 4-bit sample.  Call this in a tight loop for streaming audio.
fn void pdm_encode(nibble sample) {
    pdm_error = pdm_error + sample;
    if (pdm_error >= 8) {
        out(1);
        pdm_error = pdm_error - 15;
    } else {
        out(15);
        pdm_error = pdm_error - 1;
    }
}

// Play a flash sample table terminated by 0xFF.
fn void pdm_play(flashptr samples) {
    char sample;
    pdm_error = 0;
    sample = flash_next(&samples);
    while (sample != 255) {
        pdm_encode((nibble)sample);
        sample = flash_next(&samples);
    }
    pdm_silence();
}

// Play a flash sample table forever.
fn void pdm_play_loop(flashptr samples) {
    flashptr start;
    char sample;
    start = samples;
    pdm_error = 0;
    while (1) {
        sample = flash_next(&samples);
        if (sample == 255) {
            samples = start;
            sample = flash_next(&samples);
        }
        pdm_encode((nibble)sample);
    }
}
