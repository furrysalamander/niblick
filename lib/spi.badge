// Bit-banged SPI mode 0 on the badge's main I/O connector.
//
// Pin assignments live in lib/boards/voja4.badge:
//
//   OUT2 = SCLK
//   OUT3 = MOSI
//   OUT1 = W5500 CS / default SPI CS
//   IN0  = MISO
//
// The module uses GPIO bank 0 (WrFlags.IOPos = 0).  Unused functions are
// removed by the compiler's dead-declaration pass.  The fast SPI helpers used
// by lib/drivers/w5500.badge also assume bank 0, so call spi_init() before
// using the W5500 driver.

import "lib/boards/voja4.badge";
import "lib/gpio.badge";

fn void spi_init() {
    gpio_alt(0);
    gpio_set(SPI_CS);          // CS idle high
    gpio_clear(SPI_SCLK | SPI_MOSI);
}

fn void spi_begin() {
    gpio_clear(SPI_CS);
}

fn void spi_end() {
    gpio_set(SPI_CS);
}

// Exchange one byte, MSB first, mode 0 (sample MISO on the rising edge).
fn char spi_xfer(char out) {
    char in;
    nibble bit;

    in = 0;
    bit = 0;
    while (bit != 8) {
        if ((out & 128) != 0) {
            gpio_set(SPI_MOSI);
        } else {
            gpio_clear(SPI_MOSI);
        }
        out = out << 1;

        gpio_set(SPI_SCLK);
        in = in << 1;
        if ((in() & SPI_MISO) != 0) {
            in = in | 1;
        }
        gpio_clear(SPI_SCLK);
        bit = bit + 1;
    }
    return in;
}
