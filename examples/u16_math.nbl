// 16-bit integers, casts, and the multiply/divide/modulo operators.

import "lib/uart.nbl";

uint16_t a;
uint16_t b;
uint16_t product;
uint16_t quotient;
uint16_t remainder;
char packed;
nibble low;

fn main() {
    uart_route(1);
    uart_init(3);

    a = 1000;
    b = 37;

    product = a * b;
    quotient = a / b;
    remainder = a % b;

    uart_puts("1000 * 37 = ");
    uart_print_dec16(product);
    uart_nl();

    uart_puts("1000 / 37 = ");
    uart_print_dec16(quotient);
    uart_puts(" remainder ");
    uart_print_dec16(remainder);
    uart_nl();

    uart_puts("hex ");
    uart_print_hex16(product);
    uart_nl();

    packed = (char)product;
    low = (nibble)product;
    uart_puts("low byte ");
    uart_print_hex8(packed);
    uart_puts(" low nibble ");
    uart_print_nibble(low);
    uart_nl();
}
