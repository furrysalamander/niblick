{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BadgeC",
  "scopeName": "source.badgec",
  "patterns": [
    { "include": "#asm-blocks" },
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#function-definitions" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "asm-blocks": {
      "patterns": [
        {
          "begin": "\\b(asm)\\s*\\{",
          "beginCaptures": {
            "1": { "name": "keyword.other.asm.badgec" }
          },
          "end": "\\}",
          "contentName": "meta.embedded.block.voja4-asm",
          "patterns": [
            {
              "name": "variable.parameter.placeholder.badgec",
              "match": "\\$\\{[^}]*\\}"
            },
            { "include": "source.voja4-asm" }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.badgec",
          "match": "//.*$"
        },
        {
          "name": "comment.block.badgec",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "\\b(import)\\s+(\"(?:[^\"\\\\]|\\\\.)*\")",
          "captures": {
            "1": { "name": "keyword.other.import.badgec" },
            "2": { "name": "string.quoted.double.import.badgec" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.badgec",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.badgec",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.badgec",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.badgec",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hexadecimal.badgec",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.integer.binary.badgec",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.badgec",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+(?:(nibble|u4|i4|char|uint8_t|int8_t|int_least8_t|int_fast8_t|uint_least8_t|uint_fast8_t|u8|i8|uint16_t|int16_t|int_least16_t|int_fast16_t|uint_least16_t|uint_fast16_t|u16|i16|short|int|uint32_t|int32_t|int_least32_t|int_fast32_t|uint_least32_t|uint_fast32_t|intmax_t|uintmax_t|u32|i32|long|uint64_t|int64_t|uint_least64_t|int_least64_t|uint_fast64_t|int_fast64_t|u64|i64|bool|flashptr|void)\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.other.fn.badgec" },
            "2": { "name": "storage.type.badgec" },
            "3": { "name": "entity.name.function.badgec" }
          }
        },
        {
          "match": "\\b(nibble|u4|i4|char|uint8_t|int8_t|int_least8_t|int_fast8_t|uint_least8_t|uint_fast8_t|u8|i8|uint16_t|int16_t|int_least16_t|int_fast16_t|uint_least16_t|uint_fast16_t|u16|i16|short|int|uint32_t|int32_t|int_least32_t|int_fast32_t|uint_least32_t|uint_fast32_t|intmax_t|uintmax_t|u32|i32|long|uint64_t|int64_t|uint_least64_t|int_least64_t|uint_fast64_t|int_fast64_t|u64|i64|bool|flashptr|void)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.type.badgec" },
            "2": { "name": "entity.name.function.badgec" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.badgec",
          "match": "\\b(if|else|while|for|return|break|continue)\\b"
        },
        {
          "name": "storage.modifier.badgec",
          "match": "\\b(const|extern)\\b"
        },
        {
          "name": "constant.language.badgec",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.badgec",
          "match": "\\b(nibble|u4|i4|char|uint8_t|int8_t|int_least8_t|int_fast8_t|uint_least8_t|uint_fast8_t|u8|i8|uint16_t|int16_t|int_least16_t|int_fast16_t|uint_least16_t|uint_fast16_t|u16|i16|short|int|uint32_t|int32_t|int_least32_t|int_fast32_t|uint_least32_t|uint_fast32_t|intmax_t|uintmax_t|u32|i32|long|uint64_t|int64_t|uint_least64_t|int_least64_t|uint_fast64_t|int_fast64_t|u64|i64|bool|flashptr|void)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.badgec",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.badgec",
          "match": "<<|>>|<=|>=|==|!=|&&|\\|\\||[+\\-*/%&|^~!<>=]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.badgec",
          "match": "[(){}\\[\\],;]"
        }
      ]
    }
  }
}
