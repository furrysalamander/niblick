// Random-number helpers.
//
// `random()` reads the hardware PRNG; each read advances the LCG.  `seed(15)`
// requests a true-random seed on the next read.

fn nibble random() {
    return peek(0xFF);
}

fn void seed(nibble value) {
    poke(0xFF, value);
}

fn void rand_seed(nibble value) {
    seed(value);
}

fn char rand_byte() {
    return ((char)random() << 4) | random();
}

fn uint16_t rand_word() {
    return ((uint16_t)rand_byte() << 8) | rand_byte();
}

// Uniform 0..n-1.  n = 0 or 1 returns 0.
fn nibble rand_below(nibble n) {
    nibble r;
    if (n <= 1) {
        return 0;
    }
    r = random();
    while (r >= n) {
        r = random();
    }
    return r;
}

// Inclusive range.  hi < lo returns lo.
fn nibble rand_range(nibble lo, nibble hi) {
    if (hi < lo) {
        return lo;
    }
    if (lo == 0 && hi == 15) {
        return random();
    }
    return lo + rand_below(hi - lo + 1);
}

fn nibble rand_true() {
    seed(15);
    return random();
}
