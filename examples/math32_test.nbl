import "lib/uart.nbl";
// 32-bit math self-test.  Send the single byte 0x01 over UART to run it.
// It prints PASS/FAIL lines and a final DONE pass=XX fail=YY summary.

char pass_count;
char fail_count;
char test_no;
char c;

fn puthex(nibble v) {
    if (v < 10) {
        uart_putc('0' + v);
    } else {
        uart_putc('A' + v - 10);
    }
}

fn puthex8(char v) {
    puthex(high_nibble(v));
    puthex(low_nibble(v));
}

fn check(char actual, char expected) {
    uart_puts("T");
    puthex8(test_no);
    test_no = test_no + 1;
    if (actual == expected) {
        uart_puts(" PASS\n");
        pass_count = pass_count + 1;
    } else {
        uart_puts(" FAIL got=");
        puthex8(actual);
        uart_puts(" want=");
        puthex8(expected);
        uart_putc('\n');
        fail_count = fail_count + 1;
    }
}

fn run_tests() {
    uint32_t a;
    uint32_t b;
    uint32_t q;

    pass_count = 0;
    fail_count = 0;
    test_no = 0;
    uart_puts("\n=== NIBLICK 32-BIT TEST ===\n");

    a = 100000;
    check(peek8(&a), 0xA0);
    check(peek8(&a + 2), 0x86);
    check(peek8(&a + 4), 0x01);
    check(peek8(&a + 6), 0x00);

    b = 37;
    q = a + b;
    check(peek8(&q), 0xC5);
    check(peek8(&q + 2), 0x86);
    check(peek8(&q + 4), 0x01);
    check(peek8(&q + 6), 0x00);

    q = a - b;
    check(peek8(&q), 0x7B);
    check(peek8(&q + 2), 0x86);
    check(peek8(&q + 4), 0x01);
    check(peek8(&q + 6), 0x00);

    q = a << 4;
    check(peek8(&q), 0x00);
    check(peek8(&q + 2), 0x6A);
    check(peek8(&q + 4), 0x18);
    check(peek8(&q + 6), 0x00);

    q = a / b;
    check(peek8(&q), 0x8E);
    check(peek8(&q + 2), 0x0A);
    check(peek8(&q + 4), 0x00);
    check(peek8(&q + 6), 0x00);

    q = a % b;
    check(peek8(&q), 0x1A);
    check(peek8(&q + 2), 0x00);

    q = a * b;
    check(peek8(&q), 0x20);
    check(peek8(&q + 2), 0x75);
    check(peek8(&q + 4), 0x38);
    check(peek8(&q + 6), 0x00);

    check((a == 100000), 1);
    check((a < b), 0);
    check((a > b), 1);

    uart_puts("DONE pass=");
    puthex8(pass_count);
    uart_puts(" fail=");
    puthex8(fail_count);
    uart_putc('\n');
}

fn main() {
    uart_route(1);
    uart_init(3);

    while (1) {
        uart_puts("READY32\n");
        while (1) {
            c = uart_getc();
            if (c == 1) {
                break;
            }
        }
        run_tests();
    }
}
