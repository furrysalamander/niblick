// Compute pi and print it over UART.
//
// Machin's formula:
//
//     pi = 16*atan(1/5) - 4*atan(1/239)
//
//     atan(1/x) = 1/x - 1/(3x^3) + 1/(5x^5) - ...
//
// The work is done in fixed-point decimal with one digit per nibble.  Three
// arrays of 48 digits hold the accumulator, the current power term, and the
// current series term; that is 144 of the 176 available RAM nibbles.  The
// last three digits are guard digits that absorb truncation from the long
// divisions, so 44 decimal places are printed.
//
// After the line is printed, `t` and `term` are no longer needed.  `t` starts
// at 0x70, so t[0..31] is page-aligned and doubles as the two-page LED-matrix
// framebuffer: the result scrolls across the matrix forever, read live out
// of `acc`.

import "lib/uart.nbl";

const uint16_t FRAC = 44;
const uint16_t GUARD = 3;
const uint16_t LAST = FRAC + GUARD;
const uint16_t SIZE = LAST + 1;

nibble acc[48];
nibble t[48];
nibble term[48];

// Accumulate one atan(1/x) series into acc.
//
// `subtract` sets the sign of the first term (the sign alternates from
// there).  Only small-integer divisions are used: x is 5 or 239 and the odd
// divisor is at most about 100.
fn void atan_series(char x, char coeff, nibble subtract) {
    char i;
    char rem;
    uint16_t cur;
    nibble more;
    char k;
    char m;
    nibble sign;
    uint16_t carry;
    uint16_t v;

    // t = 10^LAST / x
    i = 0;
    while (i < SIZE) {
        t[i] = 0;
        i = i + 1;
    }
    t[0] = 1;
    i = 0;
    rem = 0;
    while (i < SIZE) {
        cur = (uint16_t)(rem * 10 + t[i]);
        t[i] = (nibble)(cur / x);
        rem = (char)(cur % x);
        i = i + 1;
    }

    k = 0;
    sign = subtract;
    more = 1;
    while (more != 0) {
        // term = t / (2k+1)
        m = (char)(2 * k + 1);
        i = 0;
        rem = 0;
        while (i < SIZE) {
            cur = (uint16_t)(rem * 10 + t[i]);
            term[i] = (nibble)(cur / m);
            rem = (char)(cur % m);
            i = i + 1;
        }

        // acc += sign ? -(coeff * term) : (coeff * term)
        i = (char)SIZE;
        carry = 0;
        while (i != 0) {
            i = i - 1;
            v = (uint16_t)(coeff * term[i] + carry);
            if (sign == 0) {
                cur = (uint16_t)(acc[i] + v);
                acc[i] = (nibble)(cur % 10);
                carry = (uint16_t)(cur / 10);
            } else if (v <= acc[i]) {
                acc[i] = (nibble)(acc[i] - v);
                carry = 0;
            } else {
                cur = (uint16_t)(v - acc[i]);
                acc[i] = (nibble)((10 - (cur % 10)) % 10);
                carry = (uint16_t)(cur / 10);
                if ((cur % 10) != 0) {
                    carry = carry + 1;
                }
            }
        }

        // t = t / x / x; stop once it is zero.
        i = 0;
        rem = 0;
        while (i < SIZE) {
            cur = (uint16_t)(rem * 10 + t[i]);
            t[i] = (nibble)(cur / x);
            rem = (char)(cur % x);
            i = i + 1;
        }
        i = 0;
        rem = 0;
        more = 0;
        while (i < SIZE) {
            cur = (uint16_t)(rem * 10 + t[i]);
            t[i] = (nibble)(cur / x);
            rem = (char)(cur % x);
            if (t[i] != 0) {
                more = 1;
            }
            i = i + 1;
        }
        k = k + 1;
        sign = (nibble)(1 - sign);
    }
}

// ---------------------------------------------------------------------------
// Matrix banner
//
// The framebuffer is t[0..31] (0x70..0x8F, pages 7 and 8): two nibbles per
// row, 8 pixels per row, top 8 rows used for 5x8 text.  Glyph data comes
// from lib/font.nbl (Voja's Hamlet font); bit 7 of each byte is the top
// row.  Glyph indices: 0-9 are the digits, 10 '.', 11 'p', 12 'i', 13 ' ',
// 14 '='.
// ---------------------------------------------------------------------------

const char glyphs[] = {
    0x7C, 0x8A, 0x92, 0xA2, 0x7C,   // 0
    0x00, 0x42, 0xFE, 0x02, 0x00,   // 1
    0x42, 0x86, 0x8A, 0x92, 0x62,   // 2
    0x44, 0x82, 0x92, 0x92, 0x6C,   // 3
    0x38, 0x48, 0x88, 0x1E, 0x08,   // 4
    0xF2, 0x92, 0x92, 0x92, 0x8C,   // 5
    0x3C, 0x52, 0x92, 0x92, 0x0C,   // 6
    0x86, 0x88, 0x90, 0xA0, 0xC0,   // 7
    0x6C, 0x92, 0x92, 0x92, 0x6C,   // 8
    0x60, 0x92, 0x92, 0x94, 0x78,   // 9
    0x00, 0x00, 0x06, 0x00, 0x00,   // 10: '.'
    0x3F, 0x24, 0x24, 0x24, 0x18,   // 11: 'p'
    0x00, 0x22, 0xBE, 0x02, 0x00,   // 12: 'i'
    0x00, 0x00, 0x00, 0x00, 0x00,   // 13: ' '
    0x28, 0x28, 0x28, 0x28, 0x28,   // 14: '='
};

// "pi = " as glyph indices.
const char PREFIX[] = { 11, 12, 13, 14, 13 };

const uint16_t FB = 0x70;   // t[0]; Page 7 on the right, page 8 on the left

// Scroll "pi = 3." and the 44 fractional digits from acc, forever.  One
// column is shifted and drawn per loop; the shift/write work itself paces
// the scroll to roughly 20 ms per column.
fn void scroll_result() {
    char i;
    char col;
    char row;
    char addr;
    char idx;
    char bits;
    nibble hi;
    nibble lo;
    nibble value;

    poke(0xF0, (nibble)(FB >> 4));   // Page = 7
    poke(0xFE, 8);                   // mid-brightness

    // The framebuffer overlaps the dead `t` array; clear it first or the
    // leftover computation junk shows in the bottom rows forever.
    row = 0;
    while (row < 32) {
        poke((char)(FB + row), 0);
        row = row + 1;
    }

    while (1) {
        i = 0;
        while (i <= FRAC + 6) {
            if (i < 5) {
                idx = PREFIX[i];
            } else if (i == 5) {
                idx = acc[0];            // '3'
            } else if (i == 6) {
                idx = 10;                // '.'
            } else {
                idx = acc[i - 6];        // acc[1..44]
            }
            col = 0;
            while (col <= 5) {
                if (col < 5) {
                    bits = glyphs[(char)(idx * 5 + col)];
                } else {
                    bits = 0;            // one blank column between glyphs
                }

                // Shift the whole framebuffer one column toward the left
                // edge (matches lib/display.nbl's display_shift_left).
                row = 0;
                while (row < 16) {
                    hi = peek((char)(FB + (row << 1)));
                    lo = peek((char)(FB + (row << 1) + 1));
                    poke((char)(FB + (row << 1)), (nibble)(((hi << 1) & 15) | (lo >> 3)));
                    poke((char)(FB + (row << 1) + 1), (nibble)((lo << 1) & 15));
                    row = row + 1;
                }

                // Draw the new column into the top 8 rows of the rightmost
                // position (matches display_set_column(base, 7, bits)).  The
                // shift and column write take ~20 ms at 250 kHz on their
                // own, which paces the scroll without an extra delay.
                if (col < 5) {
                    row = 0;
                    while (row < 8) {
                        addr = (char)(FB + (row << 1) + 1);
                        value = peek(addr);
                        if ((bits & (128 >> row)) != 0) {
                            value = (nibble)(value | 1);
                        } else {
                            value = (nibble)(value & 14);
                        }
                        poke(addr, value);
                        row = row + 1;
                    }
                }
                col = col + 1;
            }
            i = i + 1;
        }
    }
}

fn main() {
    char i;

    // Configure the UART before the computation: with RxTxPos still 0 the
    // main-header TX pin is driven by the OUT latch, which reads as a break
    // on the host side.  Printing the prefix immediately also shows the
    // program is alive while the digits are being computed.
    uart_route(1);
    uart_init(3);
    uart_puts("pi = ");

    i = 0;
    while (i < SIZE) {
        acc[i] = 0;
        i = i + 1;
    }

    atan_series(5, 16, 0);
    atan_series(239, 4, 1);

    i = 0;
    while (i <= FRAC) {
        if (i == 1) {
            uart_putc('.');
        }
        uart_putc('0' + acc[i]);
        i = i + 1;
    }
    uart_putc(13);
    uart_putc(10);

    scroll_result();
}
