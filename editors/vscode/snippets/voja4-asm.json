  },
  "Local loop": {
    "prefix": "loop",
    "body": [
      ".${1:loop}:",
      "\t$0",
      "\tGOTO .${1:loop}"
    ],
    "description": "Local assembly loop"
  },
  "Return": {
    "prefix": "ret",
    "body": [
      "RET R0, 0"
    ],
    "description": "Return from an assembly function"
  }
