import "lib/time.badge";
import "lib/display.badge";
// 4x8 signed wave field for the Supercon.6 LED matrix.
//
// The matrix is 8 columns x 16 rows.  The simulation uses a 4x8 grid and
// draws each cell as a 2x2 block, so the wave fills the display.
//
// The field is a damped discrete wave:
//
//     next_height = sum(neighbours) / 2 - previous_height
//
// Heights are signed nibbles (-8..7) stored as raw two's complement.
// `lib/signed.badge` supplies the sign extension, arithmetic shifts, and
// clamping.  A new centre impulse is injected periodically so the demo keeps
// running without input.
//
// The screen array must be the first 32-nibble global: it lands at 0x40,
// so page 4 is the right half and page 5 is the left half.

import "lib/signed.badge";

nibble screen[32];
nibble height[32];
nibble prev_height[32];
nibble next_height[32];

char frame;
nibble x;
nibble y;
char i;
char sum;
char h;

// Cell x uses two adjacent columns.  Even x maps to the high two bits of a
// display row, odd x to the low two bits.
fn void screen_or(nibble x, char row, nibble mask) {
    if (x < 2) {
        screen[16 + row] = screen[16 + row] | mask;
    } else {
        screen[row] = screen[row] | mask;
    }
}

fn void plot_cell(nibble x, nibble y, nibble value) {
    nibble magnitude;
    nibble mask;
    nibble top;
    nibble bottom;

    magnitude = s_abs4(value);
    if (magnitude < 2) {
        return;
    }

    if ((x & 1) == 0) {
        mask = 12;
    } else {
        mask = 3;
    }

    top = y << 1;
    bottom = top + 1;

    if (magnitude >= 4) {
        screen_or(x, top, mask);
        screen_or(x, bottom, mask);
    } else if (s_is_neg4(value) != 0) {
        screen_or(x, bottom, mask);
    } else {
        screen_or(x, top, mask);
    }
}

fn main() {
    char i;
    nibble x;
    nibble y;

    dimmer(15);
    leds_enable(1);
    matrix_enable(1);
    display_page(4);

    i = 0;
    while (i < 32) {
        screen[i] = 0;
        height[i] = 0;
        prev_height[i] = 0;
        next_height[i] = 0;
        i = i + 1;
    }

    frame = 0;
    while (1) {
        // Inject a centre impulse every 48 frames.
        if (frame == 0) {
            height[17] = 7;
            prev_height[17] = 0;
        }

        y = 0;
        while (y < 8) {
            x = 0;
            while (x < 4) {
                i = ((char)y << 2) + x;

                sum = 0;
                if (x > 0) {
                    sum = sum + s_ext4(height[i - 1]);
                }
                if (x < 3) {
                    sum = sum + s_ext4(height[i + 1]);
                }
                if (y > 0) {
                    sum = sum + s_ext4(height[i - 4]);
                }
                if (y < 7) {
                    sum = sum + s_ext4(height[i + 4]);
                }

                h = s_sar8(sum, 1) - s_ext4(prev_height[i]);
                h = s_clamp8(h, 0xF8, 7);
                next_height[i] = (nibble)h;

                x = x + 1;
            }
            y = y + 1;
        }

        i = 0;
        while (i < 32) {
            prev_height[i] = height[i];
            height[i] = next_height[i];
            screen[i] = 0;
            i = i + 1;
        }

        y = 0;
        while (y < 8) {
            x = 0;
            while (x < 4) {
                i = ((char)y << 2) + x;
                plot_cell(x, y, height[i]);
                x = x + 1;
            }
            y = y + 1;
        }

        display_page(4);
        frame = frame + 1;
        if (frame == 48) {
            frame = 0;
        }
        delay(1);
    }
}
