// Spinning wireframe cube for the Supercon.6 LED matrix.
//
// The matrix is 16 rows x 8 columns.  It shows two 16x4 pages side by side:
// page+1 is the left half (columns 0..3) and page is the right half
// (columns 4..7).
//
// The projection can put vertices a few columns outside the visible area.
// Instead of clamping them to the border, the cube is drawn into a 16x16
// off-screen framebuffer with four columns of margin on each side.  Only the
// middle eight columns are copied to the matrix, so clipped edges disappear
// correctly instead of being pinned to the outermost columns.
//
// A cube repeats every 90 degrees, so the sine table only covers one quadrant.
// The projection uses a fixed 30-degree camera pitch, a slightly wider
// horizontal scale, and a small fixed roll so the cube sits a little off-axis.

nibble screen[32];
nibble vfb[64];
nibble bitmask[4];

char angle;
word cb;
word sb;
nibble vx[8];
nibble vy[8];

// sin(k * 90 / 32), Q8.8 (256 = 1.0)
const word sin_q8[] = {
      0,  13,  25,  38,  50,  62,  74,  86,
     98, 109, 121, 132, 142, 152, 162, 172,
    181, 190, 198, 206, 213, 220, 226, 231,
    237, 241, 245, 248, 251, 253, 255, 256,
    256
};

// Vertex i uses bits 0/1/2 as the signs of x/y/z (1 = negative).
// These are the twelve edges of the cube: every pair differing in one bit.
const nibble cube_edges[] = {
    0, 1,  0, 2,  0, 4,
    1, 3,  1, 5,
    2, 3,  2, 6,
    3, 7,
    4, 5,  4, 6,
    5, 7,
    6, 7
};

// The virtual framebuffer is 16 columns x 16 rows, four nibbles per row.
// Visible column 0 is virtual column 4, and visible column 7 is virtual 11.
fn void put_pixel(nibble x, nibble y) {
    nibble group;
    nibble mask;
    char idx;

    group = x >> 2;
    mask = bitmask[x & 3];
    idx = y;
    idx = idx << 2;
    idx = idx + group;
    vfb[idx] = vfb[idx] | mask;
}

// Integer Bresenham with no signed arithmetic.  All coordinates are in the
// 16x16 virtual framebuffer, so this needs no clipping checks.
fn void line(nibble x0, nibble y0, nibble x1, nibble y1) {
    nibble dx;
    nibble dy;
    char err;
    nibble x;
    nibble y;
    nibble stepx;
    nibble stepy;

    x = x0;
    y = y0;

    if (x1 >= x0) {
        dx = x1 - x0;
        stepx = 1;
    } else {
        dx = x0 - x1;
        stepx = 15;
    }
    if (y1 >= y0) {
        dy = y1 - y0;
        stepy = 1;
    } else {
        dy = y0 - y1;
        stepy = 15;
    }

    if (dx >= dy) {
        err = 0;
        while (1) {
            put_pixel(x, y);
            if (x == x1) {
                break;
            }
            err = err + dy;
            if (err >= dx) {
                err = err - dx;
                if (stepy == 1) {
                    y = y + 1;
                } else {
                    y = y - 1;
                }
            }
            if (stepx == 1) {
                x = x + 1;
            } else {
                x = x - 1;
            }
        }
    } else {
        err = 0;
        while (1) {
            put_pixel(x, y);
            if (y == y1) {
                break;
            }
            err = err + dx;
            if (err >= dy) {
                err = err - dy;
                if (stepx == 1) {
                    x = x + 1;
                } else {
                    x = x - 1;
                }
            }
            if (stepy == 1) {
                y = y + 1;
            } else {
                y = y - 1;
            }
        }
    }
}

fn void build_vertices() {
    nibble i;
    nibble flags;
    nibble tx;
    char dxb;
    char dyb;
    word bx;
    word by;

    i = 0;
    while (i < 8) {
        flags = i;

        // sx = x*cb + z*sb.  Bias by 512 to keep it unsigned.
        bx = 512;
        if (flags & 1) {
            bx = bx - cb;
        } else {
            bx = bx + cb;
        }
        if (flags & 4) {
            bx = bx - sb;
        } else {
            bx = bx + sb;
        }
        // A slightly wider horizontal scale: virtual x is 2..13.
        tx = (nibble)(bx >> 6);

        // sy = y*cos(30) + (x*sb - z*cb)/2.  Bias by 478.
        by = 478;
        if (flags & 2) {
            by = by - 222;
        } else {
            by = by + 222;
        }
        if (flags & 1) {
            by = by - (sb >> 1);
        } else {
            by = by + (sb >> 1);
        }
        if (flags & 4) {
            by = by + (cb >> 1);
        } else {
            by = by - (cb >> 1);
        }
        // Small clockwise roll around virtual (8, 8), approximated with
        // eighth-pixel shifts so it costs only adds and shifts.
        //   x' = x + 2 - (y + 7)/8
        //   y' = y - 2 + (x + 8)/8
        dyb = (char)(23 - (((by << 3) + by) >> 9));
        dxb = (char)tx;
        dxb = dxb + 8;
        vx[i] = (nibble)(dxb - (dyb >> 3) - 6);
        vy[i] = (nibble)(dyb + (dxb >> 3) - 9);

        i = i + 1;
    }
}

fn void clear_fb() {
    char i;
    i = 0;
    while (i < 64) {
        vfb[i] = 0;
        i = i + 1;
    }
}

// Copy the visible middle eight columns into pages 4/5.
fn void blit() {
    char y;
    y = 0;
    while (y < 16) {
        screen[16 + y] = vfb[(y << 2) + 1];
        screen[y] = vfb[(y << 2) + 2];
        y = y + 1;
    }
}

fn void draw_edges() {
    char i;
    i = 0;
    while (i < 24) {
        line(
            vx[cube_edges[i]],
            vy[cube_edges[i]],
            vx[cube_edges[i + 1]],
            vy[cube_edges[i + 1]]
        );
        i = i + 2;
    }
}

fn main() {
    matrix_enable(1);
    dimmer(15);
    leds_enable(1);

    bitmask[0] = 8;
    bitmask[1] = 4;
    bitmask[2] = 2;
    bitmask[3] = 1;

    angle = 1;
    display_page(4);

    while (1) {
        cb = sin_q8[32 - angle];
        sb = sin_q8[angle];

        clear_fb();
        build_vertices();
        draw_edges();
        blit();

        // 16 steps over a 90-degree quadrant.  Start on an odd table entry
        // so the cube never sits exactly face-on.  A cube is symmetric every
        // 90 degrees, so this loops without a visible jump.
        angle = angle + 2;
        if (angle > 31) {
            angle = 1;
        }
        delay(1);
    }
}
