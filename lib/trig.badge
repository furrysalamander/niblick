// Q4.4 sine/cosine table.
//
// Angles are 32 steps per full circle (11.25 degrees per step).  A value is
// a raw two's-complement Q4.4 char: 0x10 = 1.0, 0x08 = 0.5, 0xF0 = -1.0.

const char sin_q4_4_table[] = {
    0x00, 0x03, 0x06, 0x09, 0x0B, 0x0D, 0x0F, 0x10,
    0x10, 0x10, 0x0F, 0x0D, 0x0B, 0x09, 0x06, 0x03,
    0x00, 0xFD, 0xFA, 0xF7, 0xF5, 0xF3, 0xF1, 0xF0,
    0xF0, 0xF0, 0xF1, 0xF3, 0xF5, 0xF7, 0xFA, 0xFD
};

const char TRIG_STEPS = 32;
const nibble TRIG_90 = 8;

fn char sin_q4_4(char angle) {
    return sin_q4_4_table[angle & 31];
}

fn char cos_q4_4(char angle) {
    return sin_q4_4_table[(angle + 8) & 31];
}
