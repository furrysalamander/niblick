import "lib/time.nbl";
import "lib/key.nbl";
import "lib/random.nbl";
import "lib/display.nbl";
import "lib/uart.nbl";
// Niblick Tetris for the Supercon.6 LED matrix.
//
// The first RAM global must be the 32-nibble screen so it lands at 0x40,
// which is page 4.  Page 4 is the right half of the matrix, page 5 (0x50)
// is the left half.  The playfield is 8 columns x 16 rows.
//
// Controls: OPCODE 8=left, 1=right, 4=rotate, 2=soft drop.

nibble screen[32];
nibble board[32];
nibble piece_rows[4];
nibble piece_left;
nibble piece_top;

nibble bitmask[4];
nibble rmask[4];

// 7 pieces x 4 rotations x 4 rows.  Bits 0..3 are left..right in a row.
const nibble shapes[] = {
    0x0F, 0x00, 0x00, 0x00,
    0x01, 0x01, 0x01, 0x01,
    0x0F, 0x00, 0x00, 0x00,
    0x01, 0x01, 0x01, 0x01,
    0x03, 0x03, 0x00, 0x00,
    0x03, 0x03, 0x00, 0x00,
    0x03, 0x03, 0x00, 0x00,
    0x03, 0x03, 0x00, 0x00,
    0x02, 0x07, 0x00, 0x00,
    0x01, 0x03, 0x01, 0x00,
    0x07, 0x02, 0x00, 0x00,
    0x02, 0x03, 0x02, 0x00,
    0x06, 0x03, 0x00, 0x00,
    0x01, 0x03, 0x02, 0x00,
    0x06, 0x03, 0x00, 0x00,
    0x01, 0x03, 0x02, 0x00,
    0x03, 0x06, 0x00, 0x00,
    0x02, 0x03, 0x01, 0x00,
    0x03, 0x06, 0x00, 0x00,
    0x02, 0x03, 0x01, 0x00,
    0x01, 0x01, 0x03, 0x00,
    0x07, 0x01, 0x00, 0x00,
    0x03, 0x02, 0x02, 0x00,
    0x04, 0x07, 0x00, 0x00,
    0x02, 0x02, 0x03, 0x00,
    0x01, 0x07, 0x00, 0x00,
    0x03, 0x01, 0x01, 0x00,
    0x07, 0x04, 0x00, 0x00
};

const nibble shape_left[] = {
    0, 3, 0, 0, 1, 2, 1, 0, 0, 2, 1, 0, 0, 2, 1, 0,
    0, 2, 1, 0, 0, 1, 2, 0, 0, 1, 2, 0
};

const nibble shape_top[] = {
    0, 0, 3, 0, 0, 1, 2, 1, 0, 0, 2, 1, 0, 0, 2, 1,
    0, 0, 2, 1, 0, 0, 1, 2, 0, 0, 1, 2
};

nibble piece_type;
nibble piece_rot;
nibble piece_x;
char piece_y;
nibble score;
nibble game_over;
nibble tick;
nibble key;
nibble lines_cleared;
nibble need_spawn;
nibble tick_limit;
nibble speed_counter;

fn load_rows(nibble rot) {
    nibble row;
    char idx;
    char r;
    char oidx;
    oidx = piece_type;
    oidx = oidx + oidx;
    oidx = oidx + oidx;
    oidx = oidx + rot;
    piece_left = shape_left[oidx];
    piece_top = shape_top[oidx];

    for (row = 0; row < 4; row = row + 1) {
        idx = piece_type;
        idx = idx + idx;
        idx = idx + idx;
        idx = idx + idx;
        idx = idx + idx;
        r = rot;
        r = r + r;
        r = r + r;
        idx = idx + r + row;
        piece_rows[row] = shapes[idx];
    }
}

fn nibble cell_get(nibble x, char y) {
    nibble v;
    if (x < 4) {
        v = board[16 + y];
        v = v & rmask[x];
    } else {
        v = board[y];
        v = v & rmask[x - 4];
    }
    if (v != 0) {
        return 1;
    }
    return 0;
}

fn cell_set(nibble x, char y, nibble value) {
    nibble old;
    nibble mask;
    if (x < 4) {
        old = board[16 + y];
        mask = rmask[x];
        if (value != 0) {
            old = old | mask;
        } else {
            old = old & (15 - mask);
        }
        board[16 + y] = old;
    } else {
        old = board[y];
        mask = rmask[x - 4];
        if (value != 0) {
            old = old | mask;
        } else {
            old = old & (15 - mask);
        }
        board[y] = old;
    }
}

fn screen_set(nibble x, char y, nibble value) {
    nibble old;
    nibble mask;
    if (x < 4) {
        old = screen[16 + y];
        mask = rmask[x];
        if (value != 0) {
            old = old | mask;
        } else {
            old = old & (15 - mask);
        }
        screen[16 + y] = old;
    } else {
        old = screen[y];
        mask = rmask[x - 4];
        if (value != 0) {
            old = old | mask;
        } else {
            old = old & (15 - mask);
        }
        screen[y] = old;
    }
}

fn clear_ram() {
    char i;
    for (i = 0; i < 16; i = i + 1) {
        screen[i] = 0;
        screen[16 + i] = 0;
        board[i] = 0;
        board[16 + i] = 0;
    }
}

fn copy_board() {
    char i;
    for (i = 0; i < 16; i = i + 1) {
        screen[i] = board[i];
        screen[16 + i] = board[16 + i];
    }
}

fn draw_piece() {
    nibble row;
    nibble bit;
    nibble mask;
    nibble xx;
    char yy;
    for (row = 0; row < 4; row = row + 1) {
        mask = piece_rows[row];
        for (bit = 0; bit < 4; bit = bit + 1) {
            if (mask & bitmask[bit]) {
                xx = piece_x + bit;
                yy = piece_y;
                yy = yy + row;
                if (xx < 8) {
                    if (yy < 16) {
                        screen_set(xx, yy, 1);
                    }
                }
            }
        }
    }
}

fn nibble collision(nibble nx, char ny, nibble rot) {
    nibble row;
    nibble bit;
    nibble mask;
    nibble xx;
    char yy;
    for (row = 0; row < 4; row = row + 1) {
        mask = piece_rows[row];
        for (bit = 0; bit < 4; bit = bit + 1) {
            if (mask & bitmask[bit]) {
                xx = nx + bit;
                yy = ny;
                yy = yy + row;
                if (xx > 7) {
                    return 1;
                }
                if (yy > 15) {
                    return 1;
                }
                if (cell_get(xx, yy)) {
                    return 1;
                }
            }
        }
    }
    return 0;
}

fn lock_piece() {
    nibble row;
    nibble bit;
    nibble mask;
    nibble xx;
    char yy;
    for (row = 0; row < 4; row = row + 1) {
        mask = piece_rows[row];
        for (bit = 0; bit < 4; bit = bit + 1) {
            if (mask & bitmask[bit]) {
                xx = piece_x + bit;
                yy = piece_y;
                yy = yy + row;
                if (xx < 8) {
                    if (yy < 16) {
                        cell_set(xx, yy, 1);
                    }
                }
            }
        }
    }
}

fn nibble row_full(char y) {
    nibble x;
    for (x = 0; x < 8; x = x + 1) {
        if (cell_get(x, y) == 0) {
            return 0;
        }
    }
    return 1;
}

fn shift_rows(char from_y) {
    char y;
    nibble x;
    y = from_y;
    while (y > 0) {
        for (x = 0; x < 8; x = x + 1) {
            cell_set(x, y, cell_get(x, y - 1));
        }
        y = y - 1;
    }
    for (x = 0; x < 8; x = x + 1) {
        cell_set(x, 0, 0);
    }
}

fn clear_lines() {
    nibble changed;
    char y;
    lines_cleared = 0;
    changed = 1;
    while (changed) {
        changed = 0;
        y = 15;
        while (1) {
            if (row_full(y)) {
                shift_rows(y);
                score = score + 1;
                lines_cleared = lines_cleared + 1;
                changed = 1;
            }
            if (y == 0) {
                break;
            }
            y = y - 1;
        }
    }

    // Every 8 cleared lines, step the fall speed down one notch.
    if (lines_cleared > 0) {
        speed_counter = speed_counter + lines_cleared;
        if (speed_counter >= 8) {
            speed_counter = speed_counter - 8;
            if (tick_limit > 5) {
                tick_limit = tick_limit - 1;
            }
        }
    }
}

fn flash_effect() {
    dimmer(15);
    delay(3);
    dimmer(5);
    delay(3);
    dimmer(15);
}

fn spawn_piece() {
    piece_type = random() & 7;
    if (piece_type > 6) {
        piece_type = piece_type - 7;
    }
    piece_rot = 0;
    piece_x = 2;
    piece_y = 0;
    load_rows(piece_rot);
    if (collision(piece_x, piece_y, piece_rot)) {
        game_over = 1;
    }
}

fn move_left() {
    if (piece_x > 0) {
        if (!collision(piece_x - 1, piece_y, piece_rot)) {
            piece_x = piece_x - 1;
        }
    }
}

fn move_right() {
    if (!collision(piece_x + 1, piece_y, piece_rot)) {
        piece_x = piece_x + 1;
    }
}

fn rotate_piece() {
    nibble oldrot;
    nibble oldleft;
    nibble oldtop;
    nibble oldx;
    char oldy;
    nibble nx;
    char ny;

    oldrot = piece_rot;
    oldleft = piece_left;
    oldtop = piece_top;
    oldx = piece_x;
    oldy = piece_y;

    piece_rot = (piece_rot + 1) & 3;
    load_rows(piece_rot);

    if (piece_x + piece_left < oldleft) {
        piece_rot = oldrot;
        load_rows(oldrot);
        piece_x = oldx;
        piece_y = oldy;
        return;
    }
    nx = piece_x + piece_left - oldleft;

    ny = piece_y;
    ny = ny + piece_top;
    ny = ny - oldtop;

    if (ny > 15) {
        piece_rot = oldrot;
        load_rows(oldrot);
        piece_x = oldx;
        piece_y = oldy;
        return;
    }
    if (ny > 15) {
        piece_rot = oldrot;
        load_rows(oldrot);
        piece_x = oldx;
        piece_y = oldy;
        return;
    }

    piece_x = nx;
    piece_y = ny;

    if (collision(piece_x, piece_y, piece_rot)) {
        if (piece_x > 0) {
            piece_x = piece_x - 1;
            if (!collision(piece_x, piece_y, piece_rot)) {
                return;
            }
            piece_x = piece_x + 2;
            if (!collision(piece_x, piece_y, piece_rot)) {
                return;
            }
            piece_x = piece_x - 1;
        } else {
            piece_x = piece_x + 1;
            if (!collision(piece_x, piece_y, piece_rot)) {
                return;
            }
            piece_x = piece_x - 1;
        }
        piece_rot = oldrot;
        load_rows(oldrot);
        piece_x = oldx;
        piece_y = oldy;
    }
}

fn step_down() {
    if (!collision(piece_x, piece_y + 1, piece_rot)) {
        piece_y = piece_y + 1;
    } else {
        lock_piece();
        clear_lines();
        if (lines_cleared > 0) {
            flash_effect();
        }
        need_spawn = 1;
    }
}

fn hard_drop() {
    while (!collision(piece_x, piece_y + 1, piece_rot)) {
        piece_y = piece_y + 1;
    }
    lock_piece();
    clear_lines();
    spawn_piece();
}

fn fill_screen(nibble v) {
    char i;
    for (i = 0; i < 16; i = i + 1) {
        screen[i] = v;
        screen[16 + i] = v;
    }
}

fn main() {
    uart_route(1);
    uart_init(3);
    dimmer(15);
    leds_enable(1);
    matrix_enable(1);
    uart_puts("Tetris: OPCODE 8=left 1=right 4=rotate 2=soft drop\n");

    bitmask[0] = 1;
    bitmask[1] = 2;
    bitmask[2] = 4;
    bitmask[3] = 8;
    rmask[0] = 8;
    rmask[1] = 4;
    rmask[2] = 2;
    rmask[3] = 1;

    while (1) {
        display_page(4);
        clear_ram();
        score = 0;
        game_over = 0;
        tick = 0;
        tick_limit = 15;
        speed_counter = 0;
        need_spawn = 0;
        spawn_piece();

        while (!game_over) {
            copy_board();
            draw_piece();

            if (key_just()) {
                key = key_code();
                if (key == 1) {
                    move_left();
                } else if (key == 4) {
                    move_right();
                } else if (key == 2) {
                    rotate_piece();
                } else if (key == 3) {
                    step_down();
                }
            }

            delay(15);
            delay(10);
            tick = tick + 1;
            if (tick >= tick_limit) {
                tick = 0;
                step_down();
            }
            if (need_spawn) {
                need_spawn = 0;
                spawn_piece();
            }
        }

        // Game over: fade, flash, then wait for any key.
        dimmer(15);
        delay(10);
        dimmer(10);
        delay(10);
        dimmer(5);
        delay(10);
        dimmer(2);
        delay(15);
        dimmer(15);
        fill_screen(15);
        delay(15);
        delay(15);
        fill_screen(0);
        delay(15);
        delay(15);
        while (!key_any()) {
        }
        delay(15);
        delay(10);
    }
}
