// Structs: named fields and arrays of structs on the badge's small RAM.
import "lib/uart.badge";

struct Point {
    nibble x;
    nibble y;
};

Point points[3];

fn main() {
    uart_route(1);
    uart_init(3);

    points[0].x = 1;
    points[0].y = 2;
    points[1].x = 3;
    points[1].y = 4;
    points[2].x = 5;
    points[2].y = 6;

    print("p0=({},{}) p1=({},{}) p2=({},{})\n",
          points[0].x, points[0].y,
          points[1].x, points[1].y,
          points[2].x, points[2].y);
}
