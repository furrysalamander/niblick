// Display-page and 8x16 framebuffer helpers.
//
// A framebuffer is 32 nibbles: two nibbles per row, 8 pixels per row,
// row-major.  `base` is the array's nibble address (use `&screen`).

import "mem.badge";

const nibble disp_masks[] = { 8, 4, 2, 1 };

fn void display_page(nibble page) {
    poke(0xF0, page);
}

fn nibble display_page_get() {
    return peek(0xF0);
}

fn void display_poke(nibble page, nibble index, nibble value) {
    poke(((char)page << 4) | index, value);
}

fn nibble display_peek(nibble page, nibble index) {
    return peek(((char)page << 4) | index);
}

// Set the LED PWM duty (0..15; 15 = brightest).
fn void dimmer(nibble value) {
    poke(0xFE, value);
}

fn nibble dimmer_get() {
    return peek(0xFE);
}

// Enable/disable the ALU panel LEDs (WrFlags.LedsOff, bit 3).
fn void leds_enable(nibble enable) {
    if (enable != 0) {
        poke(0xF3, peek(0xF3) & 7);
    } else {
        poke(0xF3, peek(0xF3) | 8);
    }
}

// Enable/disable the LED matrix (WrFlags.MatrixOff, bit 2).
fn void matrix_enable(nibble enable) {
    if (enable != 0) {
        poke(0xF3, peek(0xF3) & 11);
    } else {
        poke(0xF3, peek(0xF3) | 4);
    }
}

// Show the two display pages that contain a 32-nibble framebuffer.
fn void display_show(char base) {
    display_page(high_nibble(base));
}

fn void display_fill(nibble page, nibble value) {
    nibble i;
    i = 0;
    while (1) {
        display_poke(page, i, value);
        if (i == 15) {
            break;
        }
        i = i + 1;
    }
}

fn void display_clear(nibble page) {
    display_fill(page, 0);
}

fn void display_invert(nibble page) {
    nibble i;
    nibble v;
    i = 0;
    while (1) {
        v = display_peek(page, i);
        display_poke(page, i, v ^ 15);
        if (i == 15) {
            break;
        }
        i = i + 1;
    }
}

fn void display_copy(nibble src, nibble dst) {
    nibble i;
    i = 0;
    while (1) {
        display_poke(dst, i, display_peek(src, i));
        if (i == 15) {
            break;
        }
        i = i + 1;
    }
}

fn char disp_addr(char base, nibble x, char y) {
    return base + (y << 1) + (x >> 2);
}

fn nibble disp_mask(nibble x) {
    return disp_masks[x & 3];
}

fn nibble pixel_get(char base, nibble x, char y) {
    return (peek(disp_addr(base, x, y)) & disp_mask(x)) != 0;
}

fn void pixel_set(char base, nibble x, char y, nibble on) {
    char addr;
    nibble mask;
    nibble value;
    addr = disp_addr(base, x, y);
    mask = disp_mask(x);
    value = peek(addr);
    if (on != 0) {
        value = value | mask;
    } else {
        value = value & (mask ^ 15);
    }
    poke(addr, value);
}

fn void pixel_toggle(char base, nibble x, char y) {
    char addr;
    addr = disp_addr(base, x, y);
    poke(addr, peek(addr) ^ disp_mask(x));
}

fn void pixel_clear(char base, nibble x, char y) {
    pixel_set(base, x, y, 0);
}

fn void hline(char base, nibble x0, nibble x1, char y, nibble on) {
    while (x0 <= x1) {
        pixel_set(base, x0, y, on);
        x0 = x0 + 1;
    }
}

fn void vline(char base, nibble x, char y0, char y1, nibble on) {
    while (y0 <= y1) {
        pixel_set(base, x, y0, on);
        y0 = y0 + 1;
    }
}

fn void fill_rect(char base, nibble x0, char y0, nibble x1, char y1, nibble on) {
    while (y0 <= y1) {
        hline(base, x0, x1, y0, on);
        y0 = y0 + 1;
    }
}

fn void clear_screen(char base) {
    mem_fill(base, 0, 32);
}

// Shift a 32-nibble framebuffer one pixel to the left.  Bit 3 is the
// leftmost pixel in each nibble.
fn void display_shift_left(char base) {
    char row;
    nibble hi;
    nibble lo;
    row = 0;
    while (row < 16) {
        hi = peek(base + (row << 1));
        lo = peek(base + (row << 1) + 1);
        poke(base + (row << 1), ((hi << 1) & 15) | (lo >> 3));
        poke(base + (row << 1) + 1, (lo << 1) & 15);
        row = row + 1;
    }
}

// Set the top eight rows of one pixel column from an 8-bit column value.
fn void display_set_column(char base, nibble x, char bits) {
    char row;
    char addr;
    nibble mask;
    nibble value;
    mask = 1 << (3 - (x & 3));
    row = 0;
    while (row < 8) {
        addr = base + (row << 1) + (x >> 2);
        value = peek(addr);
        if ((bits & (128 >> row)) != 0) {
            value = value | mask;
        } else {
            value = value & (mask ^ 15);
        }
        poke(addr, value);
        row = row + 1;
    }
}
