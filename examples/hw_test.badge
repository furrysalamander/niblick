import "lib/mem.badge";
import "lib/time.badge";
import "lib/key.badge";
import "lib/random.badge";
import "lib/gpio.badge";
import "lib/display.badge";
import "lib/uart.badge";
import "lib/power.badge";
import "lib/system.badge";
// Comprehensive BadgeC hardware self-test.
//
// The program starts in a command loop and prints READY.  Send the single
// character 'R' over UART to run the tests.  It prints PASS/FAIL lines and a
// final DONE pass=XX fail=YY line, then returns to READY.

const char msg[] = "FLASH";
const nibble table[] = { 5, 6, 7, 8 };

char pass_count;
char fail_count;
char test_no;
char c;

fn puthex(nibble v) {
    if (v < 10) {
        uart_putc('0' + v);
    } else {
        uart_putc('A' + v - 10);
    }
}

fn puthex8(char v) {
    puthex(peek(&v + 1));
    puthex(peek(&v));
}

fn check(char actual, char expected) {
    uart_puts("T");
    puthex8(test_no);
    test_no = test_no + 1;
    if (actual == expected) {
        uart_puts(" PASS\n");
        pass_count = pass_count + 1;
    } else {
        uart_puts(" FAIL got=");
        puthex8(actual);
        uart_puts(" want=");
        puthex8(expected);
        uart_putc('\n');
        fail_count = fail_count + 1;
    }
}

fn nibble count_to(nibble n, nibble acc) {
    if (n == 0) {
        return acc;
    }
    return count_to(n - 1, acc + 1);
}

fn char add_char(char a, char b) {
    return a + b;
}


fn run_tests() {
    nibble n;
    nibble i;
    nibble r0;
    nibble r1;
    nibble r2;
    nibble r3;
    char cc;
    word wa;
    word we;

    pass_count = 0;
    fail_count = 0;
    test_no = 0;
    uart_puts("\n=== BADGEC HW TEST ===\n");

    // --- nibble / char arithmetic and bitwise ---
    n = 15; n = n + 1;
    check(n, 0);
    n = 5; n = n - 7;
    check(n, 14);
    check(3 + 4, 7);
    check(15 & 12, 12);
    check(1 | 2, 3);
    check(5 ^ 3, 6);

    cc = 255; cc = cc + 1;
    check(cc, 0);
    cc = 10; cc = cc - 20;
    check(cc, 246);
    cc = 65; cc = cc + 1;
    check(cc, 66);
    check(0x12 & 0x0F, 0x02);
    check(add_char(10, 20), 30);

    // --- widening multiply, divide, modulo, and casts ---
    check(7 * 9, 63);
    wa = 200 * 7;
    we = 1400;
    check((char)wa, (char)we);
    check((char)(wa >> 8), (char)(we >> 8));
    wa = 1000 * 37;
    we = 37000;
    check((char)wa, (char)we);
    check((char)(wa >> 8), (char)(we >> 8));
    check(200 / 7, 28);
    check(200 % 7, 4);
    wa = 1000 / 37;
    we = 27;
    check((char)wa, (char)we);
    check((char)(wa >> 8), (char)(we >> 8));
    wa = 1000 % 37;
    we = 1;
    check((char)wa, (char)we);
    check((char)(wa >> 8), (char)(we >> 8));
    check(15 / 0, 0);
    cc = (char)0x1234;
    check(cc, 0x34);

    // --- comparisons and logical ops ---
    check(3 < 5, 1);
    check(5 <= 5, 1);
    check(5 > 3, 1);
    check(3 >= 5, 0);
    check(5 == 5, 1);
    check(5 != 4, 1);
    check(1 && 0, 0);
    check(1 || 0, 1);
    check(!0, 1);

    // --- loops ---
    n = 0;
    for (i = 0; i < 5; i = i + 1) {
        n = n + i;
    }
    check(n, 10);

    n = 0;
    i = 0;
    while (i < 5) {
        i = i + 1;
        if (i == 3) {
            continue;
        }
        n = n + 1;
    }
    check(n, 4);

    n = 0;
    for (i = 0; i < 10; i = i + 1) {
        if (i == 4) {
            break;
        }
        n = n + 1;
    }
    check(n, 4);

    // --- tail recursion ---
    check(count_to(10, 0), 10);

    // --- RAM arrays, memset, memcpy, dynamic index ---
    nibble nbuf[4];
    nibble nbuf2[4];
    char cbuf[4];
    char cbuf2[4];

    mem_fill(&nbuf, 7, 4);
    check(nbuf[0], 7);
    check(nbuf[3], 7);
    mem_fill8(&cbuf, 65, 4);
    check(cbuf[0], 65);
    check(cbuf[3], 65);
    mem_copy(&nbuf2, &nbuf, 4);
    check(nbuf2[2], 7);
    mem_copy8(&cbuf2, &cbuf, 4);
    check(cbuf2[2], 65);

    cc = 3;
    cbuf[cc] = 66;
    check(cbuf[3], 66);

    // --- peek / poke ---
    nibble scratch[2];
    poke(&scratch, 9);
    check(peek(&scratch), 9);

    // --- flash tables and iteration ---
    check(flash_read_char(msg), 70);
    check(flash_read_nibble(table), 5);
    check(msg[1], 76);
    check(table[2], 7);

    flashptr p;
    p = msg;
    n = 0;
    while (1) {
        cc = flash_next(&p);
        if (cc == 0xFF) {
            break;
        }
        n = n + 1;
    }
    check(n, 5);

    // --- UART write from a RAM buffer ---
    char txbuf[10];
    txbuf[0] = 'R'; txbuf[1] = 'A'; txbuf[2] = 'M'; txbuf[3] = '_';
    txbuf[4] = 'T'; txbuf[5] = 'X'; txbuf[6] = '_'; txbuf[7] = 'O';
    txbuf[8] = 'K'; txbuf[9] = '\n';
    uart_write(&txbuf, 10);

    // --- GPIO / OUT / IN ---
    gpio_write(5);
    check(peek(0x0A), 5);
    gpio_set(2);
    check(peek(0x0A), 7);
    gpio_clear(1);
    check(peek(0x0A), 6);
    gpio_toggle(8);
    check(peek(0x0A), 14);

    gpio_alt(1);
    gpio_write(5);
    check(peek(0xFA), 5);
    gpio_alt(0);
    check(gpio_read(), peek(0x0B));
    check(gpio_test(0), 0);

    out(5);
    check(peek(0x0A), 5);
    check(in(), peek(0x0B));

    // --- display page / display RAM ---
    display_page(12);
    display_poke(12, 0, 15);
    check(display_peek(12, 0), 15);
    display_poke(12, 1, 5);
    check(display_peek(12, 1), 5);
    display_page(0);

    // --- SFRs: dimmer, random, WrFlags ---
    dimmer(15);
    check(peek(0xFE), 15);

    seed(3);
    r0 = random();
    r1 = random();
    r2 = random();
    r3 = random();
    check((r0 != r1) || (r1 != r2) || (r2 != r3), 1);

    uart_route(1);
    check(peek(0xF3) & 1, 1);
    gpio_alt(1);
    check(peek(0xF3) & 2, 2);
    gpio_alt(0);
    leds_enable(0);
    check(peek(0xF3) & 8, 8);
    leds_enable(1);
    matrix_enable(0);
    check(peek(0xF3) & 4, 4);
    matrix_enable(1);

    // --- system / power / UART status ---
    power_keep_awake();
    check(power_remaining(), 15);
    check(system_page(), peek(0xF0));
    check(system_dimmer(), peek(0xFE));
    check(system_uart_baud(), 3);
    check(system_uart_error(), 0);

    // --- key reads (info only; do not fail if a key is held) ---
    uart_puts("INFO key_status=");
    puthex(key_status());
    uart_puts(" key_code=");
    puthex(key_code());
    uart_puts(" any=");
    puthex(key_any());
    uart_puts(" alt=");
    puthex(key_alt());
    uart_puts(" just=");
    puthex(key_just());
    uart_puts(" last=");
    puthex(key_last());
    uart_putc('\n');

    delay(5);
    uart_puts("INFO delay done\n");

    uart_puts("DONE pass=");
    puthex8(pass_count);
    uart_puts(" fail=");
    puthex8(fail_count);
    uart_putc('\n');
}

fn main() {
    uart_route(1);
    uart_init(3);
    dimmer(15);
    leds_enable(1);
    matrix_enable(1);

    while (1) {
        uart_puts("READY\n");
        // Ignore echoed output/newlines and wait for the 0x01 start byte.
        while (1) {
            c = uart_getc();
            if (c == 1) {
                break;
            }
        }
        run_tests();
    }
}
